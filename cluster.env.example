# =============================================================================
# OKD on Fedora CoreOS (libvirt) - Cluster Configuration
# Copy to cluster.env to customize, or override via environment variables.
# =============================================================================

# Cluster Identity
CLUSTER_NAME="okd"
BASE_DOMAIN="lab.local"

# OKD & Fedora CoreOS Versions
# Browse OKD releases: https://github.com/okd-project/okd/releases
OKD_VERSION="5.0.0-okd-scos.8"
FCOS_STREAM="stable"
ARCH="x86_64"

# SSH public key injected into Fedora CoreOS nodes (core user)
SSH_PUB_KEY_PATH="${HOME}/.ssh/id_ed25519.pub"

# Pull secret file (optional for OKD community images; defaults to '{"auths":{"fake":{"auth":"aWQ6cGFzcwo="}}}')
PULL_SECRET_PATH=""

# Libvirt & Storage Paths
LIBVIRT_URI="qemu:///system"
LIBVIRT_POOL_DIR="/var/lib/libvirt/images/${CLUSTER_NAME}"
LIBVIRT_MEDIA_DIR="/var/lib/libvirt/images/okd-media"

# Libvirt NAT Network (used for dnsmasq DNS + static DHCP reservations)
NET_NAME="${CLUSTER_NAME}-net"
NET_BRIDGE="virbr-okd0"
NET_CIDR="192.168.126.0/24"
NET_GATEWAY="192.168.126.1"
NET_NETMASK="255.255.255.0"
NET_DHCP_START="192.168.126.10"
NET_DHCP_END="192.168.126.100"

# Node IP & MAC Prefix (last octet is assigned deterministically per node)
# Bootstrap: .10 | Masters: .11-.13 | Workers: .21-.29 | SNO: .11
IP_PREFIX="192.168.126"
MAC_PREFIX="52:54:00:aa:bb"

# Node Sizing
BOOTSTRAP_VCPU="4"
BOOTSTRAP_RAM_MB="16384"
BOOTSTRAP_DISK_GB="100"

MASTER_COUNT="3"
MASTER_VCPU="4"
MASTER_RAM_MB="16384"
MASTER_DISK_GB="120"

# Default worker count when Standard HA topology is selected
WORKER_COUNT="2"
WORKER_VCPU="4"
WORKER_RAM_MB="8192"
WORKER_DISK_GB="120"

SNO_VCPU="8"
SNO_RAM_MB="24576"
SNO_DISK_GB="120"

# Set TOPOLOGY to skip the interactive prompt: standard | compact | sno
TOPOLOGY=""

# Set NETWORK_MODE to skip the interactive prompt: nat | bridge
NETWORK_MODE=""
HOST_BRIDGE="br0"
USE_HAPROXY="true"
HAPROXY_BIND_IP=""
